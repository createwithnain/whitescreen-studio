# Your public, HTTPS origin, without a trailing slash. Rebuild after changing.
VITE_SITE_URL=https://your-domain.com
VITE_CONTACT_EMAIL=
VITE_SITE_OWNER=Your name or business
VITE_PUBLIC_INDEXING=true
# Ads are OFF by default. Keep them off until your site and consent setup are ready.
VITE_ADSENSE_ENABLED=false
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
